# Copy to .env and fill in real values.  .env is gitignored — NEVER commit real keys.
#   cp .env.example .env

ENVIRONMENT=development
DEBUG=true

# Datastores (match docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://rag:dev@localhost:5432/ragdb
REDIS_URL=redis://localhost:6379/0

# Auth (Day 2) — generate a strong secret for anything non-local
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Providers — needed from Week 1 D6 (embeddings) onward, leave blank until then
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Models
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=claude-sonnet-5
