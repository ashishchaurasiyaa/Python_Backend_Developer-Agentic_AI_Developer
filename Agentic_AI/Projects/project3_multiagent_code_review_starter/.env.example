# Copy this file to .env and fill in real values.  .env is gitignored.
#
#   cp .env.example .env

# --- Anthropic ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- GitHub ---
# Personal access token with repo + pull_requests scope
GITHUB_TOKEN=ghp_your-token-here
# Webhook secret (set this when registering the webhook in GitHub repo settings)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# --- Slack ---
# Incoming webhook URL from https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/here

# --- Database (LangGraph checkpointing) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/code_review

# --- Redis (Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Server ---
HOST=127.0.0.1
PORT=8000
