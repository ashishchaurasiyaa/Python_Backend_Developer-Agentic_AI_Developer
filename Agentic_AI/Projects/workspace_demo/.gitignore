# ---- Claude Code: personal / machine-local files -------------------------
# Shared config (.claude/settings.json, agents/, skills/) IS committed.
# Only personal and generated files are ignored:
.claude/settings.local.json      # your private overrides
.claude/agent-memory-local/      # local-scope subagent memory
.claude/.session/                # transient session state

